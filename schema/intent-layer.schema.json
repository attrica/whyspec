{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whyspec.example/schema/intent-layer.schema.json",
  "title": "Whyspec intent-layer profile objects",
  "description": "[INT-001] The three optional intent-layer objects. Validate a document against the $def named for its kind.",
  "x-rule": [
    "INT-001"
  ],
  "$defs": {
    "intention": {
      "type": "object",
      "x-rule": [
        "INT-002"
      ],
      "required": [
        "declared_at",
        "tree_sha",
        "scope",
        "goal",
        "approach",
        "matched",
        "matched_total",
        "session",
        "origin"
      ],
      "properties": {
        "declared_at": {
          "description": "[INT-002] When the intention was declared.",
          "x-rule": [
            "INT-002"
          ],
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "tree_sha": {
          "description": "[INT-002] The commit the scope was resolved against, or null outside version control.",
          "x-rule": [
            "INT-002"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "description": "[INT-002] Scope items in the artifact-reference grammar of §4.15 (REC-083); non-empty.",
          "x-rule": [
            "INT-002"
          ],
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "goal": {
          "description": "[INT-002] [INT-004] The goal, or null until the writer supplies it on a harness-derived record.",
          "x-rule": [
            "INT-002",
            "INT-004"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "approach": {
          "description": "[INT-002] [INT-004] The approach, or null until supplied.",
          "x-rule": [
            "INT-002",
            "INT-004"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "matched": {
          "description": "[INT-004] Each scope item mapped to the count of artifacts it resolved to at declaration.",
          "x-rule": [
            "INT-004"
          ],
          "type": "object"
        },
        "matched_total": {
          "description": "[INT-002] Total artifacts resolved across items.",
          "x-rule": [
            "INT-002"
          ],
          "type": "integer",
          "minimum": 0
        },
        "session": {
          "description": "[INT-002] The harness's session identifier, or null.",
          "x-rule": [
            "INT-002"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "description": "[INT-003] Who produced the scope: the writer, or the harness from what the session read.",
          "x-rule": [
            "INT-003"
          ],
          "type": "string",
          "enum": [
            "agent",
            "harness-reads"
          ]
        },
        "scope_capped": {
          "description": "[INT-003] Present on every harness-derived record as a boolean, true when the cap was applied; absent on an agent-declared record.",
          "x-rule": [
            "INT-003"
          ],
          "type": "boolean"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "binding_status"
            ]
          },
          {
            "required": [
              "binding_versions"
            ]
          }
        ]
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "harness-reads"
              }
            }
          },
          "then": {
            "required": [
              "scope_capped"
            ]
          },
          "else": {
            "not": {
              "required": [
                "scope_capped"
              ]
            }
          }
        }
      ]
    },
    "attestation": {
      "type": "object",
      "x-rule": [
        "INT-006"
      ],
      "required": [
        "attested_at",
        "tree_sha",
        "edited_files",
        "intention",
        "conformed",
        "superseded",
        "none",
        "session"
      ],
      "properties": {
        "attested_at": {
          "description": "[INT-006] When the session attested.",
          "x-rule": [
            "INT-006"
          ],
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "tree_sha": {
          "description": "[INT-006] The commit the session's work stands at.",
          "x-rule": [
            "INT-006"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "edited_files": {
          "description": "[INT-006] Repository-relative paths the session changed.",
          "x-rule": [
            "INT-006"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intention": {
          "description": "[INT-006] The intention record answered, or null where none was recorded.",
          "x-rule": [
            "INT-006"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "conformed": {
          "description": "[INT-006] [INT-008] Records the work followed, each with the content hash of the version followed.",
          "x-rule": [
            "INT-006",
            "INT-008"
          ],
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record",
              "blob"
            ],
            "properties": {
              "record": {
                "type": "string"
              },
              "blob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              }
            }
          }
        },
        "superseded": {
          "description": "[INT-006] [INT-007] [INT-008] Records the work departed from; every entry enters as proposed.",
          "x-rule": [
            "INT-006",
            "INT-007",
            "INT-008"
          ],
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record",
              "blob",
              "why",
              "state"
            ],
            "properties": {
              "record": {
                "type": "string"
              },
              "blob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              },
              "why": {
                "type": "string",
                "pattern": "\\S"
              },
              "state": {
                "type": "string",
                "const": "proposed"
              }
            }
          }
        },
        "none": {
          "description": "[INT-006] Scope items for edited files no record governs.",
          "x-rule": [
            "INT-006"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session": {
          "description": "[INT-006] The harness's session identifier, or null.",
          "x-rule": [
            "INT-006"
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "recall": {
      "type": "object",
      "x-rule": [
        "INT-010"
      ],
      "required": [
        "at",
        "session",
        "tool_use_id",
        "path",
        "records",
        "push_outcome",
        "tree_sha",
        "injected_chars",
        "coupling"
      ],
      "properties": {
        "at": {
          "description": "[INT-010] When the resolution ran.",
          "x-rule": [
            "INT-010"
          ],
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "session": {
          "description": "[INT-010] The harness's session identifier, or null.",
          "x-rule": [
            "INT-010"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "tool_use_id": {
          "description": "[INT-010] The harness's identifier for the accompanying tool call, or null.",
          "x-rule": [
            "INT-010"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "[INT-010] The repository-relative path resolved.",
          "x-rule": [
            "INT-010"
          ],
          "type": "string"
        },
        "records": {
          "description": "[INT-010] [INT-011] Record paths delivered; empty unless push_outcome is pushed.",
          "x-rule": [
            "INT-010",
            "INT-011"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "push_outcome": {
          "description": "[INT-011] pushed, none_governs, or resolution_failed — honest silence made mechanical.",
          "x-rule": [
            "INT-011"
          ],
          "type": "string",
          "enum": [
            "pushed",
            "none_governs",
            "resolution_failed"
          ]
        },
        "reason": {
          "description": "[INT-010] Present when and only when push_outcome is resolution_failed.",
          "x-rule": [
            "INT-010"
          ],
          "type": "string"
        },
        "tree_sha": {
          "description": "[INT-010] The commit the resolution ran against.",
          "x-rule": [
            "INT-010"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "injected_chars": {
          "description": "[INT-010] Characters of text delivered.",
          "x-rule": [
            "INT-010"
          ],
          "type": "integer",
          "minimum": 0
        },
        "coupling": {
          "description": "[INT-012] edit, intention, or the reserved spawn.",
          "x-rule": [
            "INT-012"
          ],
          "type": "string",
          "enum": [
            "edit",
            "intention",
            "spawn"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "push_outcome": {
                "const": "resolution_failed"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "push_outcome": {
                "const": "pushed"
              }
            }
          },
          "then": {
            "properties": {
              "records": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "records": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
